# Variables of the agent sessions in this checkout and its worktrees.
# Copy this file to .agents/local.env, which git ignores, and fill it in (README, Contributing).

# The token of a Notion integration connected to the Tasks Tracker and the Pull Requests database.
NOTION_API_TOKEN=
# Your Notion user: `ntn api v1/users </dev/null` lists them.
NOTION_USER_ID=
