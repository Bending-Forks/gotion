{
  "name": "gotion",
  "private": true,
  "workspaces": [
    "client/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint client packages services && depcruise client packages services"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/openapi-core": "2.79.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "typescript-eslint": "8.73.0"
  },
  "allowScripts": {
    "@confluentinc/kafka-javascript@1.11.0": true
  },
  "engines": {
    "node": "24.x"
  }
}
