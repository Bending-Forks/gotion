{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemberRoleChangedV1",
  "description": "An Admin has changed the role of a member.",
  "type": "object",
  "required": [
    "workspaceId",
    "userId",
    "role"
  ],
  "properties": {
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "description": "The new role of the member.",
      "type": "string",
      "enum": [
        "Admin",
        "Editor",
        "Viewer"
      ]
    }
  }
}
